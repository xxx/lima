# Lima port configuration; the upstream lpc-config.json is editor metadata.
LPC_NULL_MODE=distinct
LPC_LIB_DIR=lib
LPC_MASTER_OBJECT=/secure/master.c
LPC_SIMUL_EFUN_FILE=/secure/simul_efun.c
LPC_AUTO_INCLUDE_FILE=/include/audit.h
LPC_AUTO_INHERIT_FILE=
LPC_SYSTEM_INCLUDE_DIRS=/include
LPC_MAX_EXECUTION_TIME=4000
LPC_CALL_OUT_PRESERVE_PLAYER=true
